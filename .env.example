# Where the tablet app's box API lives. Leave unset to run entirely on
# sample data plus drag-and-drop exports — every screen works without it.
#
# The origin only, e.g. https://ai-chocolation.vercel.app — no trailing slash
# and no /api. Paste it as plain text: a copy that carries a byte-order mark or
# a zero-width space is invisible in every settings box, and it stops the value
# starting with "http", so the browser reads the whole thing as a path on this
# site and every call 404s. src/lib/api.ts strips those now, but the deployment
# setting is still the place to keep clean.
VITE_API_BASE=

# Local dev only: where `npm run dev` proxies /api to. Defaults to
# http://localhost:8787. Point it at the live tablet API to test against real data:
# VITE_API_TARGET=https://ai-chocolation.vercel.app
