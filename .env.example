# Where the tablet app's box API lives. The dashboard reads it on load — it is
# the only source of records — so a production build must set this (no trailing
# slash, no /api). Leave it empty for local dev and use the proxy below instead.
VITE_API_BASE=

# Local dev only: where `npm run dev` proxies /api to. Defaults to
# http://localhost:8787. Point it at the live tablet API to work against real data:
# VITE_API_TARGET=https://ai-chocolation.vercel.app
